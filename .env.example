# ============================================================
# SOVEREIGN-OS — Environment Configuration Template
# Copy this file to .env and provide your deployment secrets.
# ============================================================

# Supabase Blind Zero-Knowledge Transport Backend (Optional)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google OAuth & Identity Bridge (Optional)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# BYOS Cloud Storage (Optional - Can also be configured via in-app Cloud Cockpit)
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
VITE_AWS_REGION=us-east-1
VITE_S3_BUCKET_NAME=
